{
  "name": "@blcklab/qrypt",
  "version": "0.1.0",
  "description": "A zero-dependency, framework-agnostic TypeScript QR toolkit for generation, portable rendering, signed payloads, and matrix/image decoding.",
  "private": false,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./png": {
      "import": {
        "types": "./dist/png.d.ts",
        "default": "./dist/png.js"
      },
      "require": {
        "types": "./dist/png.d.cts",
        "default": "./dist/png.cjs"
      }
    },
    "./payloads": {
      "import": {
        "types": "./dist/payloads.d.ts",
        "default": "./dist/payloads.js"
      },
      "require": {
        "types": "./dist/payloads.d.cts",
        "default": "./dist/payloads.cjs"
      }
    },
    "./render": {
      "import": {
        "types": "./dist/render.d.ts",
        "default": "./dist/render.js"
      },
      "require": {
        "types": "./dist/render.d.cts",
        "default": "./dist/render.cjs"
      }
    },
    "./secure": {
      "import": {
        "types": "./dist/secure.d.ts",
        "default": "./dist/secure.js"
      },
      "require": {
        "types": "./dist/secure.d.cts",
        "default": "./dist/secure.cjs"
      }
    },
    "./styled": {
      "import": {
        "types": "./dist/styled.d.ts",
        "default": "./dist/styled.js"
      },
      "require": {
        "types": "./dist/styled.d.cts",
        "default": "./dist/styled.cjs"
      }
    },
    "./logo": {
      "import": {
        "types": "./dist/logo.d.ts",
        "default": "./dist/logo.js"
      },
      "require": {
        "types": "./dist/logo.d.cts",
        "default": "./dist/logo.cjs"
      }
    },
    "./decode": {
      "import": {
        "types": "./dist/decode.d.ts",
        "default": "./dist/decode.js"
      },
      "require": {
        "types": "./dist/decode.d.cts",
        "default": "./dist/decode.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsdown",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm test && npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "qr-code",
    "qrcode",
    "qr",
    "typescript",
    "svg",
    "png",
    "wifi-qr",
    "vcard",
    "icalendar",
    "rgba",
    "transparent-png",
    "qr-image",
    "signed-qr",
    "jws",
    "es256",
    "secure-qr",
    "key-rotation",
    "qr-revocation",
    "qr-replay-protection",
    "styled-qr",
    "qr-gradient",
    "qr-shapes",
    "qr-logo",
    "qr-branding",
    "qr-decoder",
    "matrix-decoding",
    "reed-solomon-decoding",
    "qr-image-decoding",
    "qr-detection",
    "raw-rgba",
    "qr-binary",
    "qr-kanji",
    "gs1-qr",
    "structured-append"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
  "type": "git",
  "url": "git+https://github.com/blcklab/qrypt.git"
}
}
