{
  "name": "@blcklab/qrypt",
  "version": "0.1.0",
  "description": "A lightweight, dependency-free TypeScript library for generating QR codes.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:foundation": "tsc -p tsconfig.json --noEmit false --outDir .foundation-check && node --test test/foundation.node.test.mjs",
    "check": "npm run typecheck && npm run test && npm run build && npm run verify:package",
    "pack:check": "npm pack --dry-run",
    "verify:encoding": "tsc -p tsconfig.json --noEmit false --outDir .m2-check && node --test test/encoding.node.test.mjs",
    "verify:ecc": "tsc -p tsconfig.json --noEmit false --outDir .m3-check && node --test test/ecc.node.test.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "tsdown": "0.23.0",
    "typescript": "5.8.3",
    "vitest": "5.0.3"
  }
}
