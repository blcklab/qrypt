{
  "name": "@blcklab/qrypt",
  "version": "0.1.0",
  "description": "A zero-dependency, framework-agnostic TypeScript QR toolkit for generation, portable rendering, signed payloads, and matrix/image decoding.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./png": {
      "import": {
        "types": "./dist/png.d.ts",
        "default": "./dist/png.js"
      },
      "require": {
        "types": "./dist/png.d.cts",
        "default": "./dist/png.cjs"
      }
    },
    "./payloads": {
      "import": {
        "types": "./dist/payloads.d.ts",
        "default": "./dist/payloads.js"
      },
      "require": {
        "types": "./dist/payloads.d.cts",
        "default": "./dist/payloads.cjs"
      }
    },
    "./render": {
      "import": {
        "types": "./dist/render.d.ts",
        "default": "./dist/render.js"
      },
      "require": {
        "types": "./dist/render.d.cts",
        "default": "./dist/render.cjs"
      }
    },
    "./secure": {
      "import": {
        "types": "./dist/secure.d.ts",
        "default": "./dist/secure.js"
      },
      "require": {
        "types": "./dist/secure.d.cts",
        "default": "./dist/secure.cjs"
      }
    },
    "./styled": {
      "import": {
        "types": "./dist/styled.d.ts",
        "default": "./dist/styled.js"
      },
      "require": {
        "types": "./dist/styled.d.cts",
        "default": "./dist/styled.cjs"
      }
    },
    "./logo": {
      "import": {
        "types": "./dist/logo.d.ts",
        "default": "./dist/logo.js"
      },
      "require": {
        "types": "./dist/logo.d.cts",
        "default": "./dist/logo.cjs"
      }
    },
    "./decode": {
      "import": {
        "types": "./dist/decode.d.ts",
        "default": "./dist/decode.js"
      },
      "require": {
        "types": "./dist/decode.d.cts",
        "default": "./dist/decode.cjs"
      }
    },
    "./advanced": {
      "import": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "require": {
        "types": "./dist/advanced.d.cts",
        "default": "./dist/advanced.cjs"
      }
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:foundation": "tsc -p tsconfig.json --noEmit false --outDir .foundation-check && node --test test/foundation.node.test.mjs",
    "check": "npm run typecheck && npm run verify:docs && npm run verify:distribution:static && npm run verify:architecture && npm run verify:hardening && npm run verify:reliability && npm run test && npm run build && npm run verify:bundle && npm run verify:package",
    "pack:check": "npm pack --dry-run",
    "verify:encoding": "tsc -p tsconfig.json --noEmit false --outDir .m2-check && node --test test/encoding.node.test.mjs",
    "verify:ecc": "tsc -p tsconfig.json --noEmit false --outDir .m3-check && node --test test/ecc.node.test.mjs",
    "verify:matrix": "tsc -p tsconfig.json --noEmit false --outDir .m4-check && node --test test/matrix.node.test.mjs",
    "verify:decode": "npm run verify:matrix && python scripts/verify-independent-decode.py",
    "verify:svg": "tsc -p tsconfig.json --noEmit false --outDir .m5-check && node --test test/svg.node.test.mjs",
    "verify:svg-decode": "npm run verify:svg && python scripts/verify-svg-render.py",
    "verify:png": "tsc -p tsconfig.json --noEmit false --outDir .m6-check && node --test test/png.node.test.mjs",
    "verify:png-decode": "npm run verify:png && python scripts/verify-png-render.py",
    "verify:conformance": "tsc -p tsconfig.json --noEmit false --outDir .m7-check && node --test test/conformance.node.test.mjs",
    "verify:conformance-reference": "npm run verify:conformance && python scripts/verify-conformance.py",
    "verify:conformance-reference:full": "npm run verify:conformance && python scripts/verify-conformance.py --full",
    "prepack": "npm run build",
    "check:release": "npm run verify:lockfile && npm run check && npm pack --dry-run",
    "verify:lockfile": "node scripts/verify-lockfile.mjs",
    "verify:distribution:static": "node --test test/distribution.node.test.mjs",
    "verify:docs": "node scripts/verify-docs.mjs",
    "verify:eci-zbar": "npm run verify:png && python scripts/verify-eci-zbar.py",
    "verify:payloads": "tsc -p tsconfig.json --noEmit false --outDir .m10-check && node --test test/payloads.node.test.mjs",
    "verify:pixels": "tsc -p tsconfig.json --noEmit false --outDir .m11-check && node --test test/pixels.node.test.mjs",
    "verify:pixels-decode": "npm run verify:pixels && python scripts/verify-rgba-png.py",
    "verify:secure": "tsc -p tsconfig.json --noEmit false --outDir .m12-check && node --test test/secure.node.test.mjs && tsc -p tsconfig.json --noEmit false --outDir .m13-check && node --test test/secure-trust.node.test.mjs",
    "verify:secure:trust": "tsc -p tsconfig.json --noEmit false --outDir .m13-check && node --test test/secure-trust.node.test.mjs",
    "verify:styled": "tsc -p tsconfig.json --noEmit false --outDir .m14-check && node --test test/styled.node.test.mjs",
    "verify:styled-decode": "npm run verify:styled && python scripts/verify-styled-render.py",
    "verify:logo": "tsc -p tsconfig.json --noEmit false --outDir .m15-check && node --test test/logo.node.test.mjs",
    "verify:logo-decode": "npm run verify:logo && python scripts/verify-logo-render.py",
    "verify:matrix-decoding": "tsc -p tsconfig.json --noEmit false --outDir .m16-check && node --test test/decode.node.test.mjs",
    "verify:matrix-decoding-reference": "npm run verify:matrix-decoding && python scripts/verify-matrix-decoder-reference.py",
    "verify:image-decoding": "tsc -p tsconfig.json --noEmit false --outDir .m17-check && node --test test/image.node.test.mjs",
    "verify:image-decoding-reference": "npm run verify:image-decoding && python scripts/verify-image-decoder-reference.py",
    "verify:advanced": "tsc -p tsconfig.json --noEmit false --outDir .m18-check && node --test test/advanced.node.test.mjs",
    "verify:advanced:reference": "npm run verify:advanced && python scripts/verify-advanced-reference.py",
    "verify:hardening": "tsc -p tsconfig.json --noEmit false --outDir .m19-check && node --test test/hardening.node.test.mjs",
    "bench:qr": "tsc -p tsconfig.json --noEmit false --outDir .m19-check && node scripts/benchmark-qr.mjs",
    "verify:architecture": "node scripts/verify-architecture.mjs",
    "verify:reliability": "tsc -p tsconfig.json --noEmit false --outDir .m20-check && node --test test/reliability.node.test.mjs",
    "verify:reliability:reference": "npm run verify:reliability && python scripts/verify-reliability-images.py",
    "verify:bundle": "node scripts/verify-bundle.mjs",
    "workflow:test": "node .workflow/test.mjs",
    "workflow:publish": "node .workflow/publish.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "tsdown": "0.23.0",
    "typescript": "5.8.3",
    "vitest": "5.0.3"
  },
  "keywords": [
    "qr-code",
    "qrcode",
    "qr",
    "typescript",
    "svg",
    "png",
    "wifi-qr",
    "vcard",
    "icalendar",
    "rgba",
    "transparent-png",
    "qr-image",
    "signed-qr",
    "jws",
    "es256",
    "secure-qr",
    "key-rotation",
    "qr-revocation",
    "qr-replay-protection",
    "styled-qr",
    "qr-gradient",
    "qr-shapes",
    "qr-logo",
    "qr-branding",
    "qr-decoder",
    "matrix-decoding",
    "reed-solomon-decoding",
    "qr-image-decoding",
    "qr-detection",
    "raw-rgba",
    "qr-binary",
    "qr-kanji",
    "gs1-qr",
    "structured-append"
  ],
  "publishConfig": {
    "access": "public"
  }
}
