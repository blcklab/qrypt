{
  "name": "@blcklab/qrypt",
  "version": "0.1.0",
  "description": "A lightweight, dependency-free TypeScript library for generating QR codes.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./png": {
      "import": {
        "types": "./dist/png.d.ts",
        "default": "./dist/png.js"
      },
      "require": {
        "types": "./dist/png.d.cts",
        "default": "./dist/png.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "tsdown",
    "verify:package": "node scripts/verify-package.mjs",
    "verify:foundation": "tsc -p tsconfig.json --noEmit false --outDir .foundation-check && node --test test/foundation.node.test.mjs",
    "check": "npm run typecheck && npm run verify:docs && npm run verify:distribution:static && npm run test && npm run build && npm run verify:package",
    "pack:check": "npm pack --dry-run",
    "verify:encoding": "tsc -p tsconfig.json --noEmit false --outDir .m2-check && node --test test/encoding.node.test.mjs",
    "verify:ecc": "tsc -p tsconfig.json --noEmit false --outDir .m3-check && node --test test/ecc.node.test.mjs",
    "verify:matrix": "tsc -p tsconfig.json --noEmit false --outDir .m4-check && node --test test/matrix.node.test.mjs",
    "verify:decode": "npm run verify:matrix && python scripts/verify-independent-decode.py",
    "verify:svg": "tsc -p tsconfig.json --noEmit false --outDir .m5-check && node --test test/svg.node.test.mjs",
    "verify:svg-decode": "npm run verify:svg && python scripts/verify-svg-render.py",
    "verify:png": "tsc -p tsconfig.json --noEmit false --outDir .m6-check && node --test test/png.node.test.mjs",
    "verify:png-decode": "npm run verify:png && python scripts/verify-png-render.py",
    "verify:conformance": "tsc -p tsconfig.json --noEmit false --outDir .m7-check && node --test test/conformance.node.test.mjs",
    "verify:conformance-reference": "npm run verify:conformance && python scripts/verify-conformance.py",
    "verify:conformance-reference:full": "npm run verify:conformance && python scripts/verify-conformance.py --full",
    "prepack": "npm run build",
    "check:release": "npm run verify:lockfile && npm run check && npm pack --dry-run",
    "verify:lockfile": "node scripts/verify-lockfile.mjs",
    "verify:distribution:static": "node --test test/distribution.node.test.mjs",
    "verify:docs": "node scripts/verify-docs.mjs"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.3",
    "tsdown": "0.23.0",
    "typescript": "5.8.3",
    "vitest": "5.0.3"
  },
  "keywords": [
    "qr-code",
    "qrcode",
    "qr",
    "typescript",
    "svg",
    "png"
  ],
  "publishConfig": {
    "access": "public"
  }
}
